# Configuración del Servidor Express
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Seguridad y Autenticación JWT
# Genera una clave secreta segura (mínimo 32 caracteres) para tu entorno local
JWT_SECRET=reemplazar_con_clave_secreta_larga_y_unica
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Base de Datos Relacional MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=bidzone_db

# Opcional: contraseñas locales para ejecutar `npm run db:seed` sin exponer secretos en el repo
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

